# The DuckDB file is a rebuildable artifact; regenerate with
# scripts/init_intelligence_db.py. The JSON seeds under data/ are the source
# of truth, so the binary DB is not tracked.
*.duckdb
*.duckdb.wal

# The repo-root .gitignore ignores *.json; the seed JSONs here ARE the
# source of truth and must be tracked, so re-include them explicitly.
!data/seed_experiments.json
!data/public_sources.json
